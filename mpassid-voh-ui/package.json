{
  "name": "mpassid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run generate",
    "build": "tsc && vite build",
    "predev": "npm run generate",
    "dev": "vite",
    "format": "prettier --write .",
    "generate": "concurrently 'npm:generate:*'",
    "generate:client": "react-openapi-client-generator ./schemas/schema.json src/api/client.ts",
    "generate:käyttöoikeus-client": "react-openapi-client-generator ./schemas/käyttöoikeus.json src/api/käyttöoikeus.ts",
    "generate:koodisto-client": "react-openapi-client-generator ./schemas/koodisto.json src/api/koodisto.ts",
    "generate:localisation-client": "react-openapi-client-generator ./schemas/localisation.json src/api/localisation.ts",
    "generate:organisaatio-client": "react-openapi-client-generator ./schemas/organisaatio.json src/api/organisaatio.ts",
    "generate:messages": "formatjs-scripts && node scripts/export-messages.js",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "vendor:build": "bash vendor/build-vendor.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "check": "npm run type-check && npm run lint"
  },
  "dependencies": {
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@fontsource/roboto": "^4.5.8",
    "@mui/icons-material": "^9.2.0",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.2.0",
    "@peculiar/x509": "^2.0.0",
    "@postinumero/storage": "^0.3.2",
    "@postinumero/use-async": "^1.0.0",
    "@rehooks/document-title": "^1.0.2",
    "axios": "^1.12.0",
    "csv-stringify": "^6.2.1",
    "deepmerge-json": "^1.5.0",
    "lodash": "^4.17.23",
    "lodash-es": "^4.17.21",
    "openapi-client-axios": "7.9.0",
    "patch-package": "^8.0.1",
    "polished": "^4.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-markdown": "^8.0.5",
    "react-router-dom": "^7.18.1",
    "reflect-metadata": "^0.2.2",
    "styled-components": "^6.4.4",
    "suspense-overlay": "^1.0.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@formatjs/cli": "^6.16.14",
    "@playwright/test": "^1.61.1",
    "@remix-run/eslint-config": "^1.6.7",
    "@types/lodash": "^4.14.184",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.26",
    "@visma/babel-preset-formatjs": "file:vendor/@visma/babel-preset-formatjs",
    "@visma/eslint-config-super-template": "file:vendor/@visma/eslint-config-super-template",
    "@visma/formatjs-scripts": "file:vendor/@visma/formatjs-scripts",
    "@visma/msw-openapi-backend-integration": "file:vendor/@visma/msw-openapi-backend-integration",
    "@visma/public.config": "file:vendor/@visma/public.config",
    "@visma/react-app-locale-utils": "file:vendor/@visma/react-app-locale-utils",
    "@visma/react-intl-bundled-messages": "file:vendor/@visma/react-intl-bundled-messages",
    "@visma/react-openapi-client-generator": "file:vendor/@visma/react-openapi-client-generator",
    "@visma/tsconfig": "file:vendor/@visma/tsconfig",
    "@visma/vite-plugin-super-template": "file:vendor/@visma/vite-plugin-super-template",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-codegen": "^4.1.5",
    "babel-plugin-formatjs": "^11.3.16",
    "buffer": "^6.0.3",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^8.23.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-formatjs": "^4.1.0",
    "eslint-plugin-no-loops": "^0.3.0",
    "fast-glob": "^3.2.11",
    "favicons": "^7.0.0-beta.5",
    "fs-extra": "^11.4.0",
    "msw": "^2.15.0",
    "openapi-backend": "^5.3.0",
    "openapi-client-axios-typegen": "^7.8.0",
    "prettier": "^2.7.1",
    "react-intl": "^10.1.18",
    "read-pkg-up": "^10.1.0",
    "slash": "^5.1.0",
    "typescript": "^5.9.3",
    "url": "^0.11.0",
    "vite": "^8.1.5",
    "vite-plugin-dynamic-base": "^1.4.1",
    "vite-plugin-dynamic-import": "^1.6.0",
    "vite-plugin-env-compatible": "^2.0.1",
    "vite-plugin-favicons-inject": "^2.1.0",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=8.0.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "overrides": {
    "react": "$react",
    "@types/react": "$@types/react",
    "graphql": "16.14.2",
    "minimatch": "9.0.9",
    "cookie": "0.7.2",
    "fast-uri": "3.1.4"
  }
}
